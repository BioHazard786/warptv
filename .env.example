# Optional stream proxy (/api/proxy). Plays http:// streams on an https site and streams that
# need a Referer or User-Agent. Leave both unset for a purely static, zero-cost deployment.

# Server secret used to sign rewritten playlist URLs. Any long random string.
# Set it as a secret on the host, never commit a real value.
PROXY_SECRET=

# Build-time flag that tells the client the proxy exists.
VITE_PROXY_ENABLED=false
